# Copy to .env and edit. Every value here is a development default; the
# production deployment supplies its own and validate_startup_config refuses to
# boot without them.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Ports on the host ---------------------------------------------------
# This machine already has several Postgres and Redis containers bound; these
# are the ones CompliPilot claims.
POSTGRES_PORT=5437
REDIS_PORT=6382
API_PORT=8000
FRONTEND_PORT=3000

# --- Backend -------------------------------------------------------------
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-any-real-deployment
# Optional. Falls back to a key derived from JWT_SECRET when unset; set it in
# production so that rotating one does not require re-encrypting the other.
# ENCRYPTION_KEY=

# For a backend run on the host rather than in the compose network.
DATABASE_URL=postgresql+psycopg://complipilot:complipilot@localhost:5437/complipilot
REDIS_URL=redis://localhost:6382/0
CELERY_BROKER_URL=redis://localhost:6382/1
CELERY_RESULT_BACKEND=redis://localhost:6382/2
CELERY_ENABLED=true

BACKEND_CORS_ORIGINS=http://localhost:3000
REQUIRE_TOTP_FOR_PRIVILEGED_ROLES=false

# --- OpenRouter ----------------------------------------------------------
# Free-tier models. Without a key the AI features return a clear "not
# configured" error rather than failing at request time.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# --- Notifications -------------------------------------------------------
# Absent credentials degrade to a recorded-but-skipped notification, so the
# reminder pipeline is still observable on a development stack.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=compliance@complipilot.in

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

REMINDER_OFFSETS_DAYS=30,15,7,3,1

# --- Frontend ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
